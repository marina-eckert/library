{
  "name": "library",
  "version": "1.0.0",
  "description": "Netology Library homework: Express, EJS, MongoDB, Passport, Socket.IO and Docker",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "prestart": "npm run build",
    "dev": "nodemon --watch src --ext ts,ejs --exec \"npm run build && node dist/app.js\"",
    "build": "tsc",
    "build:ts": "npm run build",
    "dev:ts": "tsc --watch",
    "lint": "eslint .",
    "start:ts": "npm run build && node dist/express.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "inversify": "^7.11.0",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
